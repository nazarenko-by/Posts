// Епізод 1 — мінімальна схема під каталог. Розширюємо по ходу серії:
// Review/Image/Category моделі приходять у епізодах 10/4/6, коли вони стають потрібні,
// а не всі одразу — так само, як реальний проєкт росте разом з фічами.
//
// Епізод 4 (сторінка товару): план був окрема Image-модель, спрощено до
// imageCount — зображення все одно плейсхолдери (діагональна штриховка, як
// у ProductCard), реальних файлів нема, тож relational-модель під них додала б
// шум без навчальної цінності на цьому етапі. description/specs — прості
// скалярні поля, той самий підхід.
//
// Епізод 10 (відгуки): Product.rating лишається як був — кешоване число, яким
// далі сортує каталог (епізод 6, orderBy rating_desc; перерахунок aggregate на
// кожен товар списку був би N+1). Review — окрема модель з власним рейтингом
// 1-5 на відгук; сторінка товару рахує "живий" _avg через prisma.review.aggregate()
// і показує саме його, з фолбеком на кешований Product.rating, поки в товару
// ще нема жодного відгуку.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
}

model Product {
  id        String        @id @default(cuid())
  slug      String        @unique
  title     String
  category  String
  // Гроші — завжди Int у копійках, ніколи Float. priceUAH 199000 = 1 990,00 ₴.
  priceUAH  Int
  compareAt Int?
  rating    Float         @default(0)
  badge     String?
  image     String
  imageCount Int          @default(4)
  description String?
  specs     Json?
  stock     Int           @default(0)
  status    ProductStatus @default(PUBLISHED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  reviews   Review[]
  orderItems OrderItem[]

  @@index([status, createdAt])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  author    String
  // 1-5, ціле число — той самий принцип, що priceUAH: рахуємо на бекенді, не Float.
  rating    Int
  comment   String
  verified  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([productId])
}

// Епізод 14 — авторизація власним JWT (не NextAuth — підхоплює урок з посту
// #155 про явний algorithms allowlist у verify(), lib/jwt.ts). passwordHash —
// bcrypt, ніколи сирий пароль. orders — опційний зв'язок: гостьовий чекаут
// (епізоди 11-13) і далі працює без акаунту, Order.userId просто лишається
// null для таких замовлень.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  orders       Order[]
  createdAt    DateTime @default(now())
}

// Епізод 13 — замовлення. orderSeq (не orderNumber-рядок!) — autoincrement
// Int, номер замовлення ("NBY-2026-04871", кіт: COMPONENTS.md → s_success)
// рахується на льоту з orderSeq + рік створення (lib/order-number.ts), а не
// зберігається окремим стовпцем: значення autoincrement відоме лише ПІСЛЯ
// insert, тож зберігати готовий рядок довелося б другим запитом-апдейтом.
//
// Ціни/назви товарів у OrderItem — знімок на момент покупки (productSlug/
// title/priceUAH скопійовані, а не читаються через relation щоразу): каталог
// живе своїм життям (ціни міняються, товари знімають з продажу), замовлення
// має лишатись тим, що клієнт реально купив і за скільки. productId —
// опційний FK, лише для довідки, `onDelete: SetNull` — видалення товару з
// каталогу не повинно ронять історичні замовлення.
// Епізод 14 — status/userId. Гостьові замовлення (userId null) і далі
// валідні: авторизація не стала обов'язковою для покупки, лише для перегляду
// історії. Значення статусів і кольори — буквально з кіту (COMPONENTS.md →
// s_account, "Order history rows"): пакуємо/доставлено/скасовано.
enum OrderStatus {
  PACKING
  DELIVERED
  CANCELLED
}

model Order {
  id              String      @id @default(cuid())
  orderSeq        Int         @unique @default(autoincrement())
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  status          OrderStatus @default(PACKING)
  firstName       String
  lastName        String
  email           String
  phone           String
  city            String
  address         String
  // "nova_poshta" | "courier" | "pickup" — ті самі значення, що z.enum у checkoutSchema.
  shipping        String
  shippingCostUAH Int
  // "card" | "apple_pay" | "cod"
  payment         String
  codFeeUAH       Int         @default(0)
  totalUAH        Int
  items           OrderItem[]
  createdAt       DateTime    @default(now())

  @@index([email])
  @@index([userId])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productSlug String
  title       String
  priceUAH    Int
  qty         Int

  @@index([orderId])
}
