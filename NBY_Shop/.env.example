# Postgres підключення — локально або Vercel Postgres / Supabase / Neon
DATABASE_URL="postgresql://user:password@localhost:5432/nby_shop"

# Секрет підпису JWT-сесій (lib/auth.ts). У production ОБОВ'ЯЗКОВИЙ — без нього
# застосунок кине помилку, а не підставить демо-значення. Згенеруй: openssl rand -base64 32
AUTH_SECRET=""

# (необов'язково) власний домен для canonical/OG/sitemap. На Vercel без нього
# береться системна VERCEL_PROJECT_PRODUCTION_URL автоматично.
# NEXT_PUBLIC_SITE_URL="https://your-domain.com"
