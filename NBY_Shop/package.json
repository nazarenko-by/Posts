		"class-variance-authority": "^0.7.1"
	},
	"devDependencies": {
		"typescript": "^5.6.0",
		"@types/node": "^22.0.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"prisma": "^6.0.0",
		"tailwindcss": "^4.0.0",
		"@tailwindcss/postcss": "^4.0.0",
		"tsx": "^4.19.0",
		"eslint": "^9",
		"eslint-config-next": "^16.3.0",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.8.3",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0"
	},
	"lint-staged": {
