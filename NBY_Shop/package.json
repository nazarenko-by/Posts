	"prisma": {
		"seed": "tsx prisma/seed.ts"
	},
	"dependencies": {
		"next": "^16.3.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"@prisma/client": "^6.0.0",
		"clsx": "^2.1.1",
